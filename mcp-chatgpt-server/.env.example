# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-...your-api-key-here...

# Gemini API Configuration
GEMINI_API_KEY=...your-gemini-api-key-here...

# Default Settings (Optional)
DEFAULT_MODEL=openai  # openai or gemini
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2000

# Image Generation (OpenAI Images API, uses OPENAI_API_KEY)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024      # auto | 1024x1024 | 1536x1024 | 1024x1536
OPENAI_IMAGE_QUALITY=medium      # auto | low | medium | high
OPENAI_IMAGE_FORMAT=png          # png | jpeg | webp
